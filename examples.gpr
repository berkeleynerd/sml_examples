with "sml.gpr";
with "sml_io.gpr";

project Examples is

   for Source_Dirs use ("src/");
   for Object_Dir use "obj/examples";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   for Main use ("sml_example.adb",
                 "schema_validation_example.adb",
                 "test_schema_loader.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Compiler;

   package Builder is
      for Executable ("sml_example.adb") use "sml_example";
      for Executable ("schema_validation_example.adb") use "schema_validation_example";
      for Executable ("test_schema_loader.adb") use "test_schema_loader";
   end Builder;

end Examples;
