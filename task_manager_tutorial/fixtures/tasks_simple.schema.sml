<schema>
  <simpleType>
    <name>priorityType</name>
    <restriction>
      <base>integer</base>
      <minValue>1</minValue>
      <maxValue>5</maxValue>
    </restriction>
  </simpleType>

  <simpleType>
    <name>statusType</name>
    <restriction>
      <base>string</base>
      <enumeration>
        <value>todo</value>
        <value>in_progress</value>
        <value>done</value>
        <value>blocked</value>
        <value>review</value>
      </enumeration>
    </restriction>
  </simpleType>

  <simpleType>
    <name>projectStatusType</name>
    <restriction>
      <base>string</base>
      <enumeration>
        <value>planning</value>
        <value>active</value>
        <value>on_hold</value>
        <value>completed</value>
        <value>cancelled</value>
      </enumeration>
    </restriction>
  </simpleType>

  <complexType>
    <name>metadataType</name>
    <sequence>
      <element>
        <name>version</name>
        <type>string</type>
      </element>
      <element>
        <name>last_updated</name>
        <type>string</type>
      </element>
    </sequence>
  </complexType>

  <complexType>
    <name>projectType</name>
    <sequence>
      <element>
        <name>id</name>
        <type>string</type>
      </element>
      <element>
        <name>name</name>
        <type>string</type>
      </element>
      <element>
        <name>description</name>
        <type>string</type>
        <minOccurs>0</minOccurs>
      </element>
      <element>
        <name>status</name>
        <type>projectStatusType</type>
      </element>
      <element>
        <name>created</name>
        <type>string</type>
      </element>
      <element>
        <name>owner</name>
        <type>string</type>
      </element>
    </sequence>
  </complexType>

  <complexType>
    <name>taskType</name>
    <sequence>
      <element>
        <name>id</name>
        <type>string</type>
      </element>
      <element>
        <name>project_id</name>
        <type>string</type>
      </element>
      <element>
        <name>title</name>
        <type>string</type>
      </element>
      <element>
        <name>description</name>
        <type>string</type>
        <minOccurs>0</minOccurs>
      </element>
      <element>
        <name>priority</name>
        <type>priorityType</type>
      </element>
      <element>
        <name>status</name>
        <type>statusType</type>
      </element>
      <element>
        <name>assigned_to</name>
        <type>string</type>
        <minOccurs>0</minOccurs>
      </element>
      <element>
        <name>estimated_hours</name>
        <type>decimal</type>
        <minOccurs>0</minOccurs>
      </element>
      <element>
        <name>due_date</name>
        <type>string</type>
        <minOccurs>0</minOccurs>
      </element>
      <element>
        <name>completed_date</name>
        <type>string</type>
        <minOccurs>0</minOccurs>
      </element>
    </sequence>
  </complexType>

  <complexType>
    <name>projectsType</name>
    <sequence>
      <element>
        <name>project</name>
        <type>projectType</type>
        <minOccurs>0</minOccurs>
        <maxOccurs>unbounded</maxOccurs>
      </element>
    </sequence>
  </complexType>

  <complexType>
    <name>tasksType</name>
    <sequence>
      <element>
        <name>task</name>
        <type>taskType</type>
        <minOccurs>0</minOccurs>
        <maxOccurs>unbounded</maxOccurs>
      </element>
    </sequence>
  </complexType>

  <element>
    <name>task_database</name>
    <complexType>
      <sequence>
        <element>
          <name>metadata</name>
          <type>metadataType</type>
        </element>
        <element>
          <name>projects</name>
          <type>projectsType</type>
        </element>
        <element>
          <name>tasks</name>
          <type>tasksType</type>
        </element>
      </sequence>
    </complexType>
  </element>

</schema>