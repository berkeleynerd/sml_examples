<schema>
  <element>
    <name>task</name>
    <complexType>
      <sequence>
        <element>
          <name>id</name>
          <type>string</type>
          <minLength>1</minLength>
        </element>
        <element>
          <name>title</name>
          <type>string</type>
          <minLength>1</minLength>
          <maxLength>100</maxLength>
        </element>
        <element>
          <name>priority</name>
          <type>integer</type>
          <minValue>1</minValue>
          <maxValue>5</maxValue>
        </element>
        <element>
          <name>status</name>
          <type>string</type>
          <enumeration>
            <value>todo</value>
            <value>in_progress</value>
            <value>done</value>
          </enumeration>
        </element>
        <element>
          <name>completed</name>
          <type>boolean</type>
          <minOccurs>0</minOccurs>
        </element>
      </sequence>
    </complexType>
  </element>
</schema>